 "workflow": "job-square",
 "definition": {
  "schema": "portalforge.workflow/v1",
  "name": "job-square",
  "description": "When JobRegistry emits JobRequested, compute input\u00b2 with the idempotent demo service, validate the result, complete the job on-chain once, and register execution evidence.",
  "trigger": {
   "type": "event",
   "contract": "jobs",
   "event": "JobRequested",
   "minFinality": "safe"
  },
  "concurrency": 4,
  "steps": [
   {
    "id": "guard",
    "name": "Input in range",
    "needs": [],
    "timeoutMs": 30000,
    "ui": {
     "x": 40,
     "y": 120
    },
    "type": "condition",
    "condition": {
     "op": "lte",
     "left": "trigger.args.input",
     "right": 4294967295
    }
   },
   {
    "id": "compute",
    "name": "Square via demo service",
    "needs": [
     "guard"
    ],
    "retry": {
     "maxAttempts": 5,
     "backoffMs": 1000,
     "maxBackoffMs": 15000,
     "jitter": true
    },
    "timeoutMs": 10000,
    "ui": {
     "x": 260,
     "y": 120
    },
    "type": "http",
    "connector": "demo",
    "body": {
     "jobId": "{{trigger.args.jobId}}",
     "input": "{{trigger.args.input}}"
    },
    "idempotency": "query-before-retry"
   },
   {
    "id": "check",
    "name": "Result schema",
    "needs": [
     "compute"
    ],
    "timeoutMs": 30000,
    "ui": {
     "x": 480,
     "y": 120
    },
    "type": "validate",
    "value": "steps.compute.output",
    "schema": {
     "type": "object",
     "required": [
      "result",
      "resultHash"
     ],
     "properties": {
      "result": {
       "type": "integer",
       "min": 0
      },
      "resultHash": {
       "type": "string",
       "pattern": "^0x[0-9a-f]{64}$"
      }
     }
    }
   },
   {
    "id": "complete",
    "name": "completeJob (allowlisted)",
    "needs": [
     "check"
    ],
    "retry": {
     "maxAttempts": 3,
     "backoffMs": 2000,
     "maxBackoffMs": 20000,
     "jitter": true
    },
    "timeoutMs": 120000,
    "ui": {
     "x": 700,
     "y": 120
    },
    "type": "contract_call",
    "contract": "jobs",
    "function": "completeJob",
    "args": [
     "{{trigger.args.jobId}}",
     "{{execution.id}}",
     "{{steps.compute.output.result}}",
     "{{steps.compute.output.resultHash}}"
    ],
    "mode": "write"
   },
   {
    "id": "proof",
    "name": "Register execution evidence",
    "needs": [
     "complete"
    ],
    "timeoutMs": 120000,
    "ui": {
     "x": 920,
     "y": 120
    },
    "type": "evidence",
    "kind": "execution",
    "include": [
     "trigger.eventId",
     "trigger.txHash",
     "steps.compute.output",
     "steps.complete.output.txHash"
    ],
    "register": true
   }
  ]
 },
