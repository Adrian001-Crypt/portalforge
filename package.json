{
  "name": "portalforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PortalForge — build, observe, and automate on Portaldot.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*",
    "examples/*"
  ],
  "scripts": {
    "pf": "node packages/cli/bin/pf.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "contracts:build": "cd contracts/evm && forge build && cd ../.. && tsx scripts/export-abis.ts",
    "contracts:test": "cd contracts/evm && forge test",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run contracts:test && vitest run && npm run web:build",
    "verify:local": "npm run verify && tsx scripts/e2e-local.ts",
    "smoke:testnet": "tsx scripts/smoke-testnet.ts",
    "probe": "tsx scripts/probe-network.ts",
    "keygen": "tsx scripts/keygen.ts",
    "deploy:plan": "tsx scripts/deploy.ts plan",
    "deploy:apply": "tsx scripts/deploy.ts apply",
    "deploy:verify": "tsx scripts/deploy.ts verify",
    "dev": "tsx scripts/dev.ts",
    "api": "tsx apps/api/src/main.ts",
    "indexer": "tsx services/indexer/src/main.ts",
    "worker": "tsx services/worker/src/main.ts",
    "demo-service": "tsx examples/demo-service/src/server.ts",
    "web:dev": "npm run dev -w @portalforge/web",
    "web:build": "npm run build -w @portalforge/web",
    "e2e:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.18",
    "@polkadot/api": "^16.5.6",
    "@polkadot/keyring": "^14.0.3",
    "@polkadot/util": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3",
    "hono": "^4.13.16",
    "viem": "^2.57.16",
    "zod": "^3.25.76"
  }
}
