# PortalForge configuration (copy to .env or export). Secrets never go in this file.
PF_MODE=local                      # local | testnet | demo
PF_NETWORKS=local-anvil            # comma list: local-anvil, portaldot-v3-testnet
PF_DB=data/portalforge.db
PF_API_PORT=4300
PF_API_HOST=127.0.0.1
PF_WEB_PORT=5180
PF_PUBLIC_ORIGIN=http://localhost:5180   # allowed Origin for cookie writes
PF_DEV_LOGIN=1                     # dev sign-in by handle (local/demo only; set 0 in public deployments)
PF_PUBLIC_READONLY=1               # anonymous read of public_readonly projects
PF_SEED_DEMO=1                     # create the demo project from deployments/<network>.json
PF_DEMO_SERVICE_URL=http://127.0.0.1:4310
PF_ALLOW_PRIVATE_CONNECTORS=1      # allow webhook connectors to private hosts (local demo only)
PF_ALLOW_PRIVATE_RPC=0
# Endpoint overrides (optional)
# PF_EVM_RPC_PORTALDOT_V3_TESTNET=https://test-evm-rpc-v3.portaldot.dev
# PF_NATIVE_WS_PORTALDOT_V3_TESTNET=wss://test-node-v3.portaldot.dev
# Executor identity (generated by `npm run keygen`; file mode must be 0600)
# PF_EXECUTOR_KEY_FILE_PORTALDOT_V3_TESTNET=.secrets/portaldot-v3-testnet-executor.json
PF_WORKER_CONCURRENCY=4
PF_LEASE_MS=30000
PF_INDEX_INTERVAL_MS=3000
PF_MONITOR_INTERVAL_MS=15000
# Demo service (fault injection only when DEMO_FAULTS=1)
DEMO_SERVICE_PORT=4310
DEMO_FAULTS=0
# DEMO_ADMIN_TOKEN=<at least 16 random characters>
# Optional read-only deposit simulation origin before your deployer is funded (public funded H160)
# PF_DRYRUN_ORIGIN=0x...
